<UserControl x:Class="Otis.App.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Otis.App.Controls"
             xmlns:local="using:Otis.App.Views"
             xmlns:vm="using:Otis.App.ViewModels"
             xmlns:services="using:Otis.App.Services">

  <UserControl.KeyboardAccelerators>
    <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="OnSaveInvoked" />
  </UserControl.KeyboardAccelerators>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="340" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="320" />
    </Grid.ColumnDefinitions>

    <!-- Character table -->
    <ScrollViewer Background="{ThemeResource PanelBackgroundBrush}" BorderBrush="{ThemeResource PanelBorderBrush}" BorderThickness="0,0,1,0" Padding="10">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Ellipse Width="9" Height="9" Fill="{ThemeResource CutOutBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind services:Strings.Get('LegendCutOut')}" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Ellipse Width="9" Height="9" Fill="{ThemeResource DerivedBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind services:Strings.Get('LegendDerived')}" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Ellipse Width="9" Height="9" Fill="{ThemeResource MissingBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind services:Strings.Get('LegendMissing')}" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" />
          </StackPanel>
        </StackPanel>
        <ItemsControl ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CharacterGroupViewModel">
              <StackPanel Spacing="4" Margin="0,8,0,0">
                <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SecondaryTextBrush}" CharacterSpacing="40" />
                <GridView ItemsSource="{x:Bind Cells}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnCellClicked"
                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                  <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CharacterCellViewModel">
                      <Grid Width="54" Height="68" CornerRadius="6" Background="White" BorderThickness="2"
                            BorderBrush="{x:Bind local:EditorView.CellBorder(IsSelected), Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
                        <TextBlock Text="{x:Bind Display}" FontSize="12" FontWeight="SemiBold" Margin="4,1,0,0" Foreground="Black" />
                        <Ellipse Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                 Fill="{x:Bind local:EditorView.StateBrush(State), Mode=OneWay}" />
                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Margin="4,16,4,4" Stretch="Uniform" />
                        <TextBlock Text="{x:Bind Display}" FontSize="26" Foreground="#BBBBBB" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0"
                                   Visibility="{x:Bind local:EditorView.Hidden(HasThumbnail), Mode=OneWay}" />
                        <TextBlock Text="●" FontSize="10" Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,2"
                                   Visibility="{x:Bind IsDirty, Mode=OneWay}" />
                      </Grid>
                    </DataTemplate>
                  </GridView.ItemTemplate>
                </GridView>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Page canvas -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                    Background="{ThemeResource PanelBackgroundBrush}">
      <StackPanel Orientation="Horizontal" Spacing="6" Padding="10,6">
        <Button Content="◀" Command="{x:Bind ViewModel.PreviousPageCommand, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind services:Strings.Get('PreviousPage')}" />
        <ComboBox ItemsSource="{x:Bind ViewModel.Pages, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.CurrentPage, Mode=TwoWay}" MinWidth="160" />
        <Button Content="▶" Command="{x:Bind ViewModel.NextPageCommand, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind services:Strings.Get('NextPage')}" />
        <Button Content="{x:Bind services:Strings.Get('WholePage')}" Click="OnWholePageClicked" />
        <Button Content="{x:Bind services:Strings.Get('ZoomToCutout')}" Click="OnZoomClicked" />
        <AppBarSeparator />
        <Button Content="{x:Bind services:Strings.Get('NewBox')}" Command="{x:Bind ViewModel.StartBoxCommand, Mode=OneWay}" ToolTipService.ToolTip="B" />
        <Button Content="{x:Bind services:Strings.Get('Erase')}" Command="{x:Bind ViewModel.StartErasureCommand, Mode=OneWay}" ToolTipService.ToolTip="E" />
        <AppBarSeparator />
        <Button Style="{StaticResource AccentButtonStyle}" Content="{x:Bind services:Strings.Get('Save')}" Command="{x:Bind ViewModel.SaveCommand, Mode=OneWay}" ToolTipService.ToolTip="Ctrl+S" />
        <Button Content="{x:Bind services:Strings.Get('Revert')}" Command="{x:Bind ViewModel.RevertCommand, Mode=OneWay}" />
        <Button Content="{x:Bind services:Strings.Get('Remove')}" Click="OnRemoveClicked" />
        <DropDownButton Content="{x:Bind services:Strings.Get('More')}">
          <DropDownButton.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuFlyoutItem Text="{x:Bind services:Strings.Get('AddSources')}" Command="{x:Bind ViewModel.AddSourcesCommand, Mode=OneWay}" />
              <MenuFlyoutItem Text="{x:Bind services:Strings.Get('ExportPages')}" Command="{x:Bind ViewModel.ExportPagesCommand, Mode=OneWay}" />
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
      </StackPanel>
      </ScrollViewer>
      <controls:PageCanvas Grid.Row="1" x:Name="Canvas" IsTabStop="True" KeyDown="OnCanvasKeyDown" />
      <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10" Padding="10,5" CornerRadius="5" Background="#B0000000"
              Visibility="{x:Bind local:EditorView.Shown(ViewModel.Status), Mode=OneWay}">
        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Foreground="White" FontSize="12" TextWrapping="Wrap" MaxWidth="640" />
      </Border>
    </Grid>

    <!-- Preview and build -->
    <ScrollViewer Grid.Column="2" Background="{ThemeResource PanelBackgroundBrush}" BorderBrush="{ThemeResource PanelBorderBrush}" BorderThickness="1,0,0,0" Padding="12">
      <StackPanel Spacing="10">
        <TextBlock Text="{x:Bind ViewModel.SelectionTitle, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <NumberBox x:Name="BaselineBox" Header="{x:Bind services:Strings.Get('Baseline')}" SpinButtonPlacementMode="Compact" ValueChanged="OnLineValueChanged" />
          <NumberBox x:Name="XLineBox" Grid.Column="1" Header="{x:Bind services:Strings.Get('XLine')}" SpinButtonPlacementMode="Compact" ValueChanged="OnLineValueChanged" />
        </Grid>
        <TextBlock Text="{x:Bind services:Strings.Get('PreviewTitle')}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SecondaryTextBrush}" />
        <Border Background="White" BorderBrush="{ThemeResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6" MinHeight="140" Padding="6">
          <Image Source="{x:Bind ViewModel.Preview, Mode=OneWay}" MaxHeight="260" Stretch="Uniform" />
        </Border>
        <TextBlock Text="{x:Bind services:Strings.Get('EditorHelp')}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />

        <TextBlock Text="{x:Bind services:Strings.Get('BuildTitle')}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SecondaryTextBrush}" Margin="0,12,0,0" />
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBox Header="{x:Bind services:Strings.Get('Version')}" Text="{x:Bind ViewModel.VersionText, Mode=TwoWay}" />
          <Button Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                  Content="{x:Bind services:Strings.Get('BuildFont')}" Click="OnBuildClicked" IsEnabled="{x:Bind local:EditorView.Not(ViewModel.IsBusy), Mode=OneWay}" />
        </Grid>
        <Button HorizontalAlignment="Stretch" Content="{x:Bind ViewModel.RebuildText, Mode=OneWay}" Click="OnRebuildClicked"
                Visibility="{x:Bind ViewModel.CanRebuild, Mode=OneWay}" />
        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        <TextBlock Text="{x:Bind ViewModel.BuildReport, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        <TextBlock Text="{x:Bind ViewModel.InstalledText, Mode=OneWay}" FontWeight="Medium" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="{x:Bind services:Strings.Get('OpenOutputFolder')}" Command="{x:Bind ViewModel.OpenOutputFolderCommand, Mode=OneWay}" />
          <Button Content="{x:Bind services:Strings.Get('RemoveFromWindows')}" Command="{x:Bind ViewModel.UninstallCommand, Mode=OneWay}" />
        </StackPanel>
        <ItemsControl ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BuildRecordViewModel">
              <Grid ColumnSpacing="8" Padding="0,6" BorderBrush="{ThemeResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{x:Bind Version}" FontWeight="SemiBold" />
                    <TextBlock Text="✓" Foreground="{ThemeResource CutOutBrush}" Visibility="{x:Bind IsInstalled}" />
                  </StackPanel>
                  <TextBlock Text="{x:Bind Built}" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" />
                  <TextBlock Text="{x:Bind Coverage}" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" Content="{x:Bind services:Strings.Get('Install')}" Click="OnInstallClicked" Tag="{x:Bind}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox Header="{x:Bind services:Strings.Get('SampleText')}" Text="{x:Bind ViewModel.SampleText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />
        <Image Source="{x:Bind ViewModel.Specimen, Mode=OneWay}" Stretch="Uniform" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
